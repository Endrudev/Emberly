# Block any signing keystore from being committed. debug.keystore je veřejný
# standardní Android debug klíč → zůstává trackovaný (výjimka níže); tohle
# brání omylem commitnout reálný release/upload keystore do public repa.
*.keystore
!android/app/debug.keystore
ios/Pods/
android/.gradle/
android/app/build/
android/build/
android/local.properties

# Local Expo modules (modules/*) — vlastní native moduly mají vlastní
# android/ podsložku s Gradle build výstupem, kterou výše uvedená pravidla
# nezachytí (jsou zakotvená jen na rootovský android/).
modules/*/android/.gradle/
modules/*/android/build/

