{
  "expo": {
    "name": "Emberly",
    "slug": "emberly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "emberly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.endru.emberly"
    },
    "android": {
      "package": "com.endru.emberly",
      "allowBackup": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6750A4",
          "defaultChannel": "emberly-status"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "EmberlyWidget",
              "label": "Emberly",
              "description": "Dnešní aktivity a streak přehled",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "minWidth": "300dp",
              "minHeight": "210dp",
              "maxResizeWidth": "440dp",
              "maxResizeHeight": "480dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "EmberlyWidget4x2",
              "label": "Emberly (kompakt)",
              "description": "Dnešní aktivity a streak — kompaktní verze",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "minWidth": "300dp",
              "minHeight": "140dp",
              "maxResizeWidth": "440dp",
              "maxResizeHeight": "320dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidBackupRules.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "263b2050-726e-4767-8bc1-0bf19d84e88b"
      }
    },
    "owner": "endev-studio"
  }
}
