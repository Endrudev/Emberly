{
  "expo": {
    "name": "Mission Tracker",
    "slug": "mission-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "missiontracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.endru.missiontracker"
    },
    "android": {
      "package": "com.endru.missiontracker",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6750A4",
          "defaultChannel": "mission-tracker-status"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MissionWidget",
              "label": "Mission Tracker",
              "description": "Dnešní aktivity a streak přehled",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "minWidth": "300dp",
              "minHeight": "210dp",
              "maxWidth": "440dp",
              "maxHeight": "480dp",
              "updatePeriodMillis": 1800000,
              "resizableHorizontal": true,
              "resizableVertical": true
            },
            {
              "name": "MissionWidget4x2",
              "label": "Mission Tracker (kompakt)",
              "description": "Dnešní aktivity a streak — kompaktní verze",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "minWidth": "300dp",
              "minHeight": "140dp",
              "maxWidth": "440dp",
              "maxHeight": "320dp",
              "updatePeriodMillis": 1800000,
              "resizableHorizontal": true,
              "resizableVertical": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
