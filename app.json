{
  "expo": {
    "name": "Mission Tracker",
    "slug": "mission-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "missiontracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.endru.missiontracker"
    },
    "android": {
      "package": "com.endru.missiontracker",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6750A4",
          "defaultChannel": "mission-tracker-status"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
